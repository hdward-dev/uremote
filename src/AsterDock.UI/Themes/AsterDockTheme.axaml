    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.ad-caption /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Margin" Value="2"/>
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.ad-caption:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}"/>
  </Style>
  <Style Selector="Button.ad-caption:pointerover /template/ ContentPresenter">
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
  </Style>
  <Style Selector="Button.ad-caption:pressed">
