  <Style Selector="Button.ad-segment">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="4,0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource AppStrongTextBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    <Setter Property="RenderTransform" Value="scale(1)"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.ad-segment /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AppStrongTextBrush}"/>
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="4,0"/>
  </Style>
  <Style Selector="Button.ad-segment.selected">
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
  </Style>
  <Style Selector="Button.ad-segment.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
  </Style>
  <Style Selector="Button.ad-segment:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   Button.ad-segment:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
  </Style>
  <Style Selector="Button.ad-segment:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.02)"/>
  </Style>
  <Style Selector="Button.ad-segment:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)"/>
  </Style>
  <Style Selector="Button.ad-segment:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style Selector="Button.ad-outline">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AppStrongTextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="18,6"/>
    <Setter Property="MinWidth" Value="88"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.ad-outline /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AppStrongTextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
  </Style>
  <Style Selector="Button.ad-outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppCaptionHoverBrush}"/>
  </Style>

  <Style Selector="controls|AdLoadingIndicator">
    <Setter Property="ShapeBrush" Value="{DynamicResource AppAccentBrush}"/>
    <Setter Property="ContainerBrush" Value="{DynamicResource AppLoadingContainerBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppStrongTextBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="controls|AdSkeleton">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <!-- Dialogs sit on Ursa's overlay host. Keep the chrome flat: no scale, no blur. -->
  <Style Selector="u|CustomDialogControl">
    <Setter Property="Transitions" Value="{x:Null}"/>
    <Setter Property="RenderTransform" Value="none"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Focusable" Value="False"/>
  </Style>
  <Style Selector="u|CustomDialogControl /template/ Border#PART_Border">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="u|CustomDialogControl /template/ Button#PART_CloseButton">
    <Setter Property="IsVisible" Value="False"/>
    <Setter Property="Width" Value="0"/>
    <Setter Property="Height" Value="0"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <Style Selector="u|OverlayDialogHost">
    <Setter Property="OverlayMaskBrush" Value="{DynamicResource AppScrimBrush}"/>
  </Style>

  <Style Selector="Button.ad-dialog-primary">
    <Setter Property="MinWidth" Value="88"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.ad-dialog-primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
  </Style>
  <Style Selector="Button.ad-dialog-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}"/>
  </Style>
  <Style Selector="Button.ad-dialog-danger">
    <Setter Property="MinWidth" Value="88"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="{DynamicResource AppDangerBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppOnDangerBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.ad-dialog-danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppDangerBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppOnDangerBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
  </Style>
  <Style Selector="Button.ad-dialog-secondary">
    <Setter Property="MinWidth" Value="88"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppStrongTextBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.ad-dialog-secondary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppStrongTextBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
  </Style>
  <Style Selector="Button.ad-dialog-quiet">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Button.ad-dialog-quiet /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Button.ad-dialog-quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppCaptionHoverBrush}"/>
  </Style>
</Styles>
