<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="URemote.Module.LocalPasswordWindow"
        x:CompileBindings="False"
        Title="快速连接" Width="440" SizeToContent="Height" CanResize="False"
        Background="{DynamicResource AppPageBrush}"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock x:Name="titleText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppStrongTextBrush}" TextWrapping="Wrap"/>
    <TextBlock x:Name="subtitleText" Classes="ad-muted" FontSize="12" TextWrapping="Wrap"/>
    <TextBox x:Name="passwordBox" PasswordChar="●" PlaceholderText="输入密码；无密码认证可留空"/>
    <TextBlock Text="密码仅用于本次连接，不会保存。" Classes="ad-muted" FontSize="12"/>
    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
      <Button Content="取消" IsCancel="True" Click="Cancel_Click"/>
      <Button Classes="ad-primary" Content="连接" IsDefault="True" Click="Connect_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
