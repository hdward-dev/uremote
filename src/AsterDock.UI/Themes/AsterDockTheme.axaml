  <Style Selector="Button.ad-nav.selected Path">
    <Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}"/>
  </Style>
  <Style Selector="Button.ad-nav.selected /template/ ContentPresenter#PART_ContentPresenter">
