<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AsterDock.UI.Controls"
        xmlns:u="https://irihi.tech/ursa">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppPageBrush" Color="#F5F7FA"/>
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="AppCookieBrush" Color="#ECEEF2"/>
          <SolidColorBrush x:Key="AppChromeBrush" Color="#F8FAFD"/>
          <SolidColorBrush x:Key="AppBorderBrush" Color="#E2E7EF"/>
          <SolidColorBrush x:Key="AppMutedBrush" Color="#667085"/>
          <SolidColorBrush x:Key="AppPreviewBrush" Color="#E9EDF3"/>
          <SolidColorBrush x:Key="AppStrongTextBrush" Color="#000000"/>
          <SolidColorBrush x:Key="AppAccentBrush" Color="#1267E8"/>
          <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#0F5CCD"/>
          <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#0C4CAA"/>
          <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="AppAccentSurfaceBrush" Color="#E8F0FE"/>
          <SolidColorBrush x:Key="AppSelectionBrush" Color="#EEF5FF"/>
          <SolidColorBrush x:Key="AppSubtleBrush" Color="#F2F4F7"/>
          <SolidColorBrush x:Key="AppInputBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="AppInputBorderBrush" Color="#C9D2E0"/>
          <SolidColorBrush x:Key="AppInputHoverBorderBrush" Color="#8FA0B8"/>
          <SolidColorBrush x:Key="AppFocusBrush" Color="#176FEA"/>
          <SolidColorBrush x:Key="AppPositiveBrush" Color="#16883F"/>
          <SolidColorBrush x:Key="AppPositiveSurfaceBrush" Color="#E8F5EC"/>
          <SolidColorBrush x:Key="AppWarningBrush" Color="#B54708"/>
          <SolidColorBrush x:Key="AppWarningSurfaceBrush" Color="#FFF4E8"/>
          <SolidColorBrush x:Key="AppDangerBrush" Color="#C42B1C"/>
          <SolidColorBrush x:Key="AppDangerSurfaceBrush" Color="#FDECEC"/>
          <SolidColorBrush x:Key="AppOnDangerBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="AppControlBorderBrush" Color="#98A2B3"/>
          <SolidColorBrush x:Key="AppCaptionHoverBrush" Color="#E7EBF1"/>
          <SolidColorBrush x:Key="AppScrimBrush" Color="#CC1B2430"/>
          <SolidColorBrush x:Key="AppOnScrimBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="AppLoadingScrimBrush" Color="#ADF5F7FA"/>
          <SolidColorBrush x:Key="AppLoadingContainerBrush" Color="#1F1267E8"/>
          <SolidColorBrush x:Key="AppSkeletonBrush" Color="#E6EBF2"/>
          <SolidColorBrush x:Key="AppSkeletonHighlightBrush" Color="#F8FAFC"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppPageBrush" Color="#111318"/>
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#1B1F26"/>
          <SolidColorBrush x:Key="AppCookieBrush" Color="#2E3644"/>
          <SolidColorBrush x:Key="AppChromeBrush" Color="#161A20"/>
          <SolidColorBrush x:Key="AppBorderBrush" Color="#303641"/>
          <SolidColorBrush x:Key="AppMutedBrush" Color="#AEB7C4"/>
          <SolidColorBrush x:Key="AppPreviewBrush" Color="#0D0F13"/>
          <SolidColorBrush x:Key="AppStrongTextBrush" Color="#E7EBF1"/>
          <SolidColorBrush x:Key="AppAccentBrush" Color="#6EA8FF"/>
          <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#8DBAFF"/>
          <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#5796EF"/>
          <SolidColorBrush x:Key="AppOnAccentBrush" Color="#0B1A2C"/>
          <SolidColorBrush x:Key="AppAccentSurfaceBrush" Color="#1B3555"/>
          <SolidColorBrush x:Key="AppSelectionBrush" Color="#1A3557"/>
          <SolidColorBrush x:Key="AppSubtleBrush" Color="#272C34"/>
          <SolidColorBrush x:Key="AppInputBrush" Color="#232831"/>
          <SolidColorBrush x:Key="AppInputBorderBrush" Color="#46505E"/>
          <SolidColorBrush x:Key="AppInputHoverBorderBrush" Color="#707B89"/>
          <SolidColorBrush x:Key="AppFocusBrush" Color="#78AEFF"/>
          <SolidColorBrush x:Key="AppPositiveBrush" Color="#63D38A"/>
          <SolidColorBrush x:Key="AppPositiveSurfaceBrush" Color="#193B28"/>
          <SolidColorBrush x:Key="AppWarningBrush" Color="#F2B45F"/>
          <SolidColorBrush x:Key="AppWarningSurfaceBrush" Color="#3A2C16"/>
          <SolidColorBrush x:Key="AppDangerBrush" Color="#FF7B72"/>
          <SolidColorBrush x:Key="AppDangerSurfaceBrush" Color="#3A2220"/>
          <SolidColorBrush x:Key="AppOnDangerBrush" Color="#1B1F26"/>
          <SolidColorBrush x:Key="AppControlBorderBrush" Color="#7E8998"/>
          <SolidColorBrush x:Key="AppCaptionHoverBrush" Color="#2A3038"/>
          <SolidColorBrush x:Key="AppScrimBrush" Color="#E610141C"/>
          <SolidColorBrush x:Key="AppOnScrimBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="AppLoadingScrimBrush" Color="#8C05070B"/>
          <SolidColorBrush x:Key="AppLoadingContainerBrush" Color="#336EA8FF"/>
          <SolidColorBrush x:Key="AppSkeletonBrush" Color="#262C35"/>
          <SolidColorBrush x:Key="AppSkeletonHighlightBrush" Color="#3A4250"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <ControlTheme x:Key="{x:Type controls:AdLoadingOverlay}" TargetType="controls:AdLoadingOverlay">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="DelayMs" Value="150"/>
        <Setter Property="MinimumVisibleMs" Value="300"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
          <ControlTemplate>
            <Grid>
              <ContentPresenter x:Name="PART_Content"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
              <Border x:Name="PART_Scrim" IsVisible="False" IsHitTestVisible="True"
                      Background="{DynamicResource AppLoadingScrimBrush}"
                      CornerRadius="{TemplateBinding CornerRadius}">
                <Border x:Name="PART_Card" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource AppSurfaceBrush}"
                        CornerRadius="20" Padding="24,20"
                        BoxShadow="0 8 24 0 #1F000000">
                  <StackPanel x:Name="PART_Chrome" HorizontalAlignment="Center" Spacing="12">
                    <controls:AdLoadingIndicator x:Name="PART_Indicator" HorizontalAlignment="Center"
                                                 Size="{TemplateBinding IndicatorSize}"
                                                 Text="{TemplateBinding Text}"
                                                 FontSize="14"
                                                 Variant="Contained"/>
                    <Button x:Name="PART_Cancel" Classes="ad-outline" Content="取消" HorizontalAlignment="Center"
                            IsVisible="{TemplateBinding IsCancellable}"/>
                  </StackPanel>
                </Border>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type controls:PageHeader}" TargetType="controls:PageHeader">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{DynamicResource AppChromeBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1">
              <Grid Height="64" Margin="26,0" ColumnDefinitions="Auto,*">
                <StackPanel VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{TemplateBinding Title}" FontSize="23" FontWeight="SemiBold"
                             Foreground="{DynamicResource AppStrongTextBrush}"/>
                  <TextBlock Text="{TemplateBinding Subtitle}" FontSize="12"
                             Foreground="{DynamicResource AppMutedBrush}"/>
                </StackPanel>
                <ContentPresenter Grid.Column="1"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Semi defaults to ButtonDefaultPrimaryForeground even for ordinary buttons.
       Use neutral app text while keeping semantic and primary variants explicit. -->
  <Style Selector="Button">
    <Setter Property="Foreground" Value="{DynamicResource AppStrongTextBrush}"/>
  </Style>

  <Style Selector="Border.ad-card">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>
  <Style Selector="Border.ad-workspace-card">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="11"/>
  </Style>
  <Style Selector="Border.ad-section-card">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Button.ad-icon">
