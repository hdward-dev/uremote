  </Style>
  <!-- Semi applies interaction colors to PART_ContentPresenter, not Button. -->
  <Style Selector="Button.ad-primary:not(:disabled):pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:not(:disabled):pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.ad-accent:not(:disabled):pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.accent:not(:disabled):pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.ad-segment-item.selected:not(:disabled):pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
  </Style>
  <Style Selector="Button.ad-primary:not(:disabled):pressed /template/ ContentPresenter#PART_ContentPresenter, Button.primary:not(:disabled):pressed /template/ ContentPresenter#PART_ContentPresenter, Button.ad-accent:not(:disabled):pressed /template/ ContentPresenter#PART_ContentPresenter, Button.accent:not(:disabled):pressed /template/ ContentPresenter#PART_ContentPresenter, Button.ad-segment-item.selected:not(:disabled):pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentPressedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
  </Style>

